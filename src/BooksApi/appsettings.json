  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": ""
  },

  "Jwt": {
    "Issuer": "BooksApi",
    "Audience": "BooksApi.Clients",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
