  },

  "Teacher": {
    "Secret": ""
  },

  "Storage": {
    "Root": "storage"
  },

  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "Anbani <no-reply@anbani.ge>",
    "EnableSsl": true
  },

  "Hosting": {
